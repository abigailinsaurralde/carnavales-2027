{
  "name": "carnavales-2027",
  "private": true,
  "version": "0.1.0",
  "description": "VOTACIONES2027 — Sistema de Votación Digital para Comparsas de Carnaval Goya 2027",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test",
    "test:e2e": "vitest run tests/e2e",
    "db:init": "node scripts/db/db.mjs init",
    "db:migrate": "node scripts/db/db.mjs migrate",
    "db:reset": "node scripts/db/db.mjs reset",
    "docker:down": "docker compose -f docker/compose.yaml down",
    "docker:up": "docker compose -f docker/compose.yaml up -d"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
