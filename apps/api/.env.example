# VOTACIONES2027 — Backend API Environment Variables
# Copy to .env and fill in real values.

# Database
# PostgreSQL 18.4 del entorno Docker del proyecto: puerto HOST 5433 -> 5432 del
# contenedor (ver docs/operations/docker.md). Base de DESARROLLO: votaciones2027.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/votaciones2027

# Server
PORT=3000
NODE_ENV=development

# CORS (comma-separated origins, or * for dev)
CORS_ORIGINS=*

# Session TTL en horas. Default del código: 12.
SESSION_TTL_HOURS=12

# Rate limiting (mismos nombres que en apps/api/src/config.ts)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_ADMIN_WRITE_MAX=60
RATE_LIMIT_DEFAULT_MAX=300
