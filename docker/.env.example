# VOTACIONES2027 — Docker (postgres) — plantilla de variables
# =============================================================================
# Copia este archivo como `docker/.env` SOLO si necesitas desviarte de los
# valores por defecto de desarrollo. Sin `docker/.env`, Compose usa los valores
# por defecto documentados aquí.
#
# ADVERTENCIA: credenciales e infraestructura EXCLUSIVAS de desarrollo local.
# Nada de esto debe utilizarse en producción.
# =============================================================================

# Usuario superusuario del clúster PostgreSQL dockerizado (rol de inicialización
# y desarrollo; las migraciones se ejecutan con este rol en el contenedor).
POSTGRES_USER=postgres

# Contraseña de desarrollo SOLO (documentada a propósito; nunca producción).
POSTGRES_PASSWORD=postgres

# Base de datos de DESARROLLO del contenedor (separada de votaciones2027_e2e,
# que es exclusiva de los tests end-to-end y se recrea con cada corrida).
POSTGRES_DB=votaciones2027