# Normalize line endings to LF on text files
* text=auto eol=lf

# Binary files should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.wasm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Lockfiles tracked as text
package-lock.json text eol=lf
npm-shrinkwrap.json text eol=lf
pnpm-lock.yaml text eol=lf
yarn.lock text eol=lf
