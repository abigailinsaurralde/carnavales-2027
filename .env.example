############################################################
# Plantilla de variables de entorno
############################################################
#
# Este archivo (.env.example) es SOLO una TERCERA PARTE de ejemplo.
# No contiene credenciales reales.
#
# Nunca coloques credenciales, contraseñas, tokens, claves privadas o
# datos personales reales en este archivo ni en ningún archivo que se
# suba a Git.
#
# Para tu entorno local:
#   1. Copia este archivo:  cp .env.example .env
#   2. Rellena `.env` con tus propios valores (NO versionar `.env`).
#   3. Nunca subas `.env` al repositorio.
#
############################################################

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto del servidor API
PORT=3000

# Cadena de conexión a PostgreSQL
# Sustituye USER, PASSWORD, HOST y DATABASE por tus propios valores LOCALES.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Secreto para firmar JWT sesiones de Better Auth.
# Cambia este valor por una cadena aleatoria de 32 bytes generada en local.
# EJEMPLO de generación (terminal):
#   openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_32_BYTE_SECRET

# URL pública base de Better Auth (para enlaces y verificación de sesión).
BETTER_AUTH_URL=http://localhost:3000

# Orígenes CORS permitidos (comas separan múltiples orígenes).
CORS_ORIGIN=http://localhost:5173
