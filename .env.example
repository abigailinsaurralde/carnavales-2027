############################################################
# Plantilla de variables de entorno
############################################################
#
# Este archivo (.env.example) es SOLO una TERCERA PARTE de ejemplo.
# No contiene credenciales reales.
#
# Nunca coloques credenciales, contraseñas, tokens, claves privadas o
# datos personales reales en este archivo ni en ningún archivo que se
# suba a Git.
#
# Para tu entorno local:
#   1. Copia este archivo:  cp .env.example .env
#   2. Rellena `.env` con tus propios valores (NO versionar `.env`).
#   3. Nunca subas `.env` al repositorio.
#
############################################################

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto del servidor API
PORT=3000

# Cadena de conexión a PostgreSQL
# Contrato real (apps/api/src/config.ts): obligatoria, sin valor por defecto.
# Ejemplo del entorno Docker del proyecto (ver docs/operations/docker.md):
#   PostgreSQL 18.4 en Docker, puerto HOST 5433 -> 5432 del contenedor.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/votaciones2027

# Orígenes CORS permitidos (coma separa múltiples orígenes). '*' solo en
# desarrollo; en production el comodín está prohibido.
CORS_ORIGINS=http://localhost:5173

# Duración de sesión en horas. Default del código: 12.
SESSION_TTL_HOURS=12

# Rate limiting (mismos nombres que DEFAULT_RATE_LIMIT en apps/api/src/config.ts)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_ADMIN_WRITE_MAX=60
RATE_LIMIT_DEFAULT_MAX=300
